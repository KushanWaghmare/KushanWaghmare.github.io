# Environment Configuration for Kushan Waghmare Portfolio

# Server Configuration
PORT=3000
NODE_ENV=development

# Client URL for CORS (change in production)
CLIENT_URL=http://localhost:3000

# Email Configuration for Contact Form
# Gmail SMTP settings (you can use other email providers)
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your-app-password-here

# Email where contact form submissions will be sent
CONTACT_EMAIL=kushan@example.com

# Database Configuration (if using MongoDB in future)
# MONGODB_URI=mongodb://localhost:27017/portfolio
# MONGODB_DB_NAME=portfolio

# Redis Configuration (if using Redis for session storage)
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# JWT Secret (if implementing authentication)
# JWT_SECRET=your-super-secret-jwt-key-here
# JWT_EXPIRES_IN=7d

# API Keys (for third-party services)
# GITHUB_API_TOKEN=your-github-token
# GOOGLE_ANALYTICS_ID=your-ga-id

# Security Configuration
# SESSION_SECRET=your-session-secret-here
# BCRYPT_ROUNDS=12

# File Upload Configuration
# MAX_FILE_SIZE=5242880
# UPLOAD_PATH=./uploads

# Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# Social Media Links
# GITHUB_URL=https://github.com/KushanWaghmare
# LINKEDIN_URL=https://linkedin.com/in/kushanwaghmare
# TWITTER_URL=https://twitter.com/kushanwaghmare

# Feature Flags
# ENABLE_REAL_TIME_FEATURES=true
# ENABLE_ANALYTICS=true
# ENABLE_CONTACT_FORM=true

# Development Tools
# DEBUG=portfolio:*
# LOG_LEVEL=debug
